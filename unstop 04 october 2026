class Solution {
  public:
    int findPerimeter(vector<vector<int>> &mat) {
        int m = mat.size(), n = mat[0].size();

        int ans = 0;
        for(int i = 0; i < m; i++) {
            for(int j = 0; j < n; j++) {
                if(mat[i][j]) {
                    ans += 4;
                    if(i > 0 && mat[i - 1][j]) ans -= 2;
                    if(j > 0 && mat[i][j - 1]) ans -= 2;
                }
            }
        }

        return ans;
    }
};

class Solution {
  public:
    int maxFrequency(vector<int>& arr, int k) {
        // Abhi Code Karo
        int n = arr.size();
        int l = 0;
        int ans = 0;
        int wSum = 0;
        sort(arr.begin(), arr.end());

        for(int r=0; r<n; r++) {
            wSum += arr[r];

            // calculate actual sum = arr[r] * (r-l+1)
            while(arr[r] * (r-l+1) - wSum > k) {
                wSum -= arr[l];   // window shrink kr rhe h
                l++;
            }
            ans = max(ans, r-l+1);
        }
       return ans; 
    }
};

// TC=> O(NlogN) + O(N)
// SC=> O(1)
